# Backend-only configuration. Do not add this key to Expo or mobile source.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_MEAL_VISION_TIMEOUT_SECONDS=90
GEMINI_MAX_IMAGE_BYTES=5242880
GEMINI_MEAL_PARSE_THINKING_LEVEL=low
GEMINI_MEAL_VISION_THINKING_LEVEL=low
GEMINI_DIET_PLAN_THINKING_LEVEL=medium
GEMINI_TRAINING_PLAN_THINKING_LEVEL=medium
