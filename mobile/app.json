{
  "expo": {
    "name": "Training App",
    "slug": "training-app",
    "scheme": "trainingapp",
    "platforms": ["android"],
    "icon": "./assets/icon.png",
    "version": "0.12.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.konazin.trainingapp",
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101216"
      }
    },
    "plugins": [
      "expo-video",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permitir que o Training App fotografe uma refeição somente quando você iniciar uma análise.",
          "photosPermission": "Permitir que o Training App selecione uma refeição somente quando você iniciar uma análise.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F8"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist.ttf",
            "./assets/fonts/GeistMono.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fe460b9f-bb25-4c7c-b982-97d459d6702c"
      }
    },
    "owner": "konaz"
  }
}
