{
  "expo": {
    "name": "Training App",
    "slug": "training-app",
    "scheme": "trainingapp",
    "icon": "./assets/icon.png",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f4f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.konazin.trainingapp"
    },
    "android": {
      "package": "com.konazin.trainingapp",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": [
      "expo-video",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "fe460b9f-bb25-4c7c-b982-97d459d6702c"
      }
    },
    "owner": "konaz"
  }
}
