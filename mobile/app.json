{
  "expo": {
    "name": "Training App",
    "slug": "training-app",
    "scheme": "trainingapp",
    "icon": "./assets/icon.png",
    "version": "0.10.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.konazin.trainingapp"
    },
    "android": {
      "package": "com.konazin.trainingapp",
      "versionCode": 16,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101216"
      }
    },
    "plugins": [
      "expo-video",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F8"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "dark"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "fe460b9f-bb25-4c7c-b982-97d459d6702c"
      }
    },
    "owner": "konaz"
  }
}
