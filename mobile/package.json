{
  "name": "training-mobile",
  "version": "0.9.2",
  "private": true,
  "main": "expo/AppEntry.js",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-font-sizes.mjs && vitest run --passWithNoTests && jest --runInBand --config jest.config.cjs",
    "test:behavior": "jest --runInBand --config jest.config.cjs",
    "check:font-sizes": "node scripts/check-font-sizes.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@training/training-domain": "*",
    "@training/training-local-db": "*",
    "@training/training-wger": "*",
    "expo": "~56.0.18",
    "expo-constants": "~56.0.22",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-navigation-bar": "~56.0.3",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.0",
    "expo-video": "~56.1.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
