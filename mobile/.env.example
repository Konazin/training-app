# Use o IP da sua máquina quando executar em um celular físico.
# Android Emulator usa 10.0.2.2 automaticamente quando esta variável não existe.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080/api
# Token do beta privado. Variáveis EXPO_PUBLIC são embutidas no bundle e não são secretas.
EXPO_PUBLIC_API_TOKEN=troque-por-um-token-beta
